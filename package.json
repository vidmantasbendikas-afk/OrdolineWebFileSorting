{
  "name": "ordoline-web-file-sorting",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "test": "playwright test",
    "test:fast": "playwright test --grep-invert @slow",
    "test:docker": "docker compose run --rm tests",
    "reference": "docker compose run --rm reference",
    "package": "node scripts/package-release.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
